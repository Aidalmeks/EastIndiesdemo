Cell[CellGroupData[{

Cell["8. 附加实验：正弦 spread 的 trailing sigma", "Section",ExpressionUUID->"28e85691-55d4-46cf-bcb4-bc6b88ae157d"],

Cell["这一节不读数据库。请从上到下运行；随后只改 beta、cenxAmplitudeSlope 或 window，再从这一节的第一格重新运行。这里故意让 CENX 的振幅随时间线性变大，于是你能看见固定 beta 面对振幅变化时，spread 与 trailing sigma 如何变化。", "Text",ExpressionUUID->"9e319af9-cd2c-4f9f-9f91-5341ef7f4611"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"days", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", " ", "240"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"beta", " ", "=", " ", ".3"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"aaAmplitude", " ", "=", " ", ".30"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cenxAmplitude", " ", "=", " ", ".50"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"cenxAmplitudeSlope", " ", "=", " ", "0.8"}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"aa", " ", "=", " ", 
   RowBox[{"1", " ", "+", " ", 
    RowBox[{"aaAmplitude", " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"2", " ", "Pi", " ", 
       RowBox[{"days", "/", "20"}]}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cenx", " ", "=", " ", 
   RowBox[{"1", " ", "+", " ", 
    RowBox[{"cenxAmplitude", " ", 
     RowBox[{"(", 
      RowBox[{"1", " ", "+", " ", 
       RowBox[{"cenxAmplitudeSlope", " ", 
        RowBox[{"days", "/", 
         RowBox[{"Max", "[", "days", "]"}]}]}]}], ")"}], " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"2", " ", "Pi", " ", 
       RowBox[{"days", "/", "20"}]}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"spread", " ", "=", " ", 
    RowBox[{"aa", " ", "-", " ", 
     RowBox[{"beta", " ", "cenx"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Take", "[", 
    RowBox[{"spread", ",", " ", "5"}], "]"}], ",", " ", 
   RowBox[{"Take", "[", 
    RowBox[{"spread", ",", " ", 
     RowBox[{"-", "5"}]}], "]"}]}], "}"}]}], "Input",
 CellChangeTimes->{{3.995259393488847*^9, 3.995259441326046*^9}},
 CellLabel->"In[84]:=",ExpressionUUID->"b9970c34-e1cc-4f00-ac3b-1caadb2dc938"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "0.7`", ",", "0.7461980406590546`", ",", "0.7875800025915785`", ",", 
     "0.8201390236646797`", ",", "0.8407563644116827`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
    "0.6695661914785551`", ",", "0.6745159646771892`", ",", 
     "0.6817786571789334`", ",", "0.6905749816715642`", ",", "0.7`"}], 
    "}"}]}], "}"}]], "Output",
 CellChangeTimes->{
  3.9952590836824827`*^9, {3.995259396006957*^9, 3.99525944582902*^9}},
 CellLabel->"Out[92]=",ExpressionUUID->"6cd1c857-647b-41f3-bec4-820bc9fddf2f"]
}, Open  ]],

Cell["先观察这一格：beta = .6 正好等于初始振幅比 .30/.50；但 CENX 的振幅继续长大，原本的抵消会逐渐失效。把 cenxAmplitudeSlope 改成 0 再运行，会看到 spread 退成一条水平线。", "Text",ExpressionUUID->"18b72555-bef4-4f8d-a7d9-b8f92b29caec"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"window", " ", "=", " ", "40"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mean", " ", "=", " ", 
   RowBox[{"MovingAverage", "[", 
    RowBox[{"spread", ",", " ", "window"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"meanDays", " ", "=", " ", 
    RowBox[{"days", "[", 
     RowBox[{"[", 
      RowBox[{"window", " ", ";;"}], "]"}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"windows", " ", "=", " ", 
   RowBox[{"Partition", "[", 
    RowBox[{"spread", ",", " ", "window", ",", " ", "1"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sigma", " ", "=", " ", 
   RowBox[{"StandardDeviation", " ", "/@", " ", "windows"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"upper", " ", "=", " ", 
   RowBox[{"mean", " ", "+", " ", 
    RowBox[{"2", " ", "sigma"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"lower", " ", "=", " ", 
    RowBox[{"mean", " ", "-", " ", 
     RowBox[{"2", " ", "sigma"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Dimensions", "[", "windows", "]"}], ",", " ", 
   RowBox[{"Length", "[", "spread", "]"}], ",", " ", 
   RowBox[{"Length", "[", "mean", "]"}], ",", " ", 
   RowBox[{"Length", "[", "sigma", "]"}], ",", " ", 
   RowBox[{"First", "[", "sigma", "]"}], ",", " ", 
   RowBox[{"Last", "[", "sigma", "]"}]}], "}"}]}], "Input",
 CellChangeTimes->{{3.995259466656275*^9, 3.99525946721467*^9}, {
  3.995259516871089*^9, 3.99525951755348*^9}},
 CellLabel->
  "In[111]:=",ExpressionUUID->"bf40613e-7208-4a3e-b3a7-a2bb81f60101"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"202", ",", "40"}], "}"}], ",", "241", ",", "202", ",", "202", ",",
    "0.10032532479512422`", ",", "0.028886009840023652`"}], "}"}]], "Output",
 CellChangeTimes->{
  3.995259125813323*^9, {3.995259398326446*^9, 3.995259470136839*^9}, 
   3.995259519879681*^9},
 CellLabel->
  "Out[118]=",ExpressionUUID->"0e0e22fb-b6f9-43ed-9888-00cec114e3d0"]
}, Open  ]],

Cell["这一格正是你刚才卡住的地方：StandardDeviation 的输入必须是一段数据，例如一个 20 点窗口；不能写 StandardDeviation[20]。这里 /@ 的意思是：对 windows 里的每一段 20 点数据，各做一次 StandardDeviation。Range[0,240] 一共 241 点，因此会得到 222 个 20 点窗口。", "Text",ExpressionUUID->"b4822fba-dd1a-40f1-8c75-3245fd48e8f6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", "\n", " ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"days", ",", " ", "spread"}], "}"}], "]"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"meanDays", ",", " ", "mean"}], "}"}], "]"}], ",", "\n", "  ", 
     
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"meanDays", ",", " ", "upper"}], "}"}], "]"}], ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"meanDays", ",", " ", "lower"}], "}"}], "]"}]}], "}"}], ",", 
   "\n", " ", 
   RowBox[{"Joined", " ", "->", " ", "True"}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Blue", ",", " ", "White", ",", " ", "Red", ",", " ", "Red"}], 
     "}"}]}], ",", "\n", " ", 
   RowBox[{"Background", " ", "->", " ", 
    RowBox[{"RGBColor", "[", 
     RowBox[{".055", ",", " ", ".07", ",", " ", ".10"}], "]"}]}], ",", "\n", 
   " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameStyle", " ", "->", " ", "White"}], ",", " ", 
   RowBox[{"LabelStyle", " ", "->", " ", "White"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<day\>\"", ",", " ", "\"\<spread\>\""}], "}"}]}], ",", "\n", 
   " ", 
   RowBox[{"GridLines", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"None", ",", " ", "Automatic"}], "}"}]}], ",", " ", 
   RowBox[{"GridLinesStyle", " ", "->", " ", "Gray"}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<spread\>\"", ",", " ", "\"\<trailing mean\>\"", ",", 
      " ", "\"\<+2 sigma\>\"", ",", " ", "\"\<-2 sigma\>\""}], "}"}]}], ",", 
   "\n", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "1000"}]}], "]"}]], "Input",
 CellLabel->
  "In[119]:=",ExpressionUUID->"8b7bce67-2227-4cde-8b8d-dc3de8e155a9"],

