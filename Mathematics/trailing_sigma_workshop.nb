Cell["\<\
dates = data[\"Dates\"];
y = data[\"PricesY\"]/First[data[\"PricesY\"]];
x = data[\"PricesX\"]/First[data[\"PricesX\"]];
beta = .642;
spread = y - beta x;
Length /@ {dates, y, x, spread}\
\>", "Text",ExpressionUUID->"ea2d43ef-b6a7-4983-88e4-c93e92ce12a6"],

