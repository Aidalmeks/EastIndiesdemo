Cell["7. \:9ed1\:677f\:7ec3\:4e60", "Section",ExpressionUUID->"1a695890-ce00-4769-ae4e-b66fd672d01b"],

Cell["\<\
\:82e5 P_t = 31.80\:ff0c\:4e14 P_(t-20) = 29.40\:ff0c\:5219 D_t = (31.80 - \
29.40)/20 = 0.12\:3002\
\>", "Text",ExpressionUUID->"8ac21758-117e-424d-aec3-53b99f802d7c"],

Cell["\:8bf7\:89e3\:91ca\:ff1a0.12 \:8868\:793a\:4ef7\:683c\:6da8\:4e86 0.12\
\:ff0c\:8fd8\:662f\:5747\:7ebf\:76f8\:5bf9\:6628\:5929\:79fb\:52a8\:4e86 0.12\
\:ff1f", "Text",ExpressionUUID->"244c621a-b5a0-4183-9405-002bc829ff02"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"A", "*", 
    RowBox[{"Sin", "[", 
     RowBox[{"2", "*", "Pi", "*", "x"}], "]"}]}], "+", "B"}]}]], "Input",
 CellChangeTimes->{{3.995248392300912*^9, 3.99524845234578*^9}},
 CellLabel->"In[36]:=",ExpressionUUID->"8f62573e-00ca-4840-ad74-f0d7769bbe24"]
}, Open  ]]

,
Cell[CellGroupData[{

Cell["动手实验：20 日周期的正弦价格", "Section",ExpressionUUID->"098193ee-605b-47f0-9c93-1479e670681c"],

Cell["你刚刚写出了 f[x_] := 这个正确骨架。现在这一格只做两件事：指定波动高度 A 和中心线 B，然后把周期设为 20 天。请亲手运行它。", "Text",ExpressionUUID->"5417c69c-e0ea-4e5d-bb68-917ba85e2f3f"],

Cell["A = 1;\nB = 0;\nf[x_] := A Sin[2 Pi x/20] + B", "Input",ExpressionUUID->"a3f01b9a-dd48-46d2-bcec-6a4a5adad804"],

Cell["接下来把“从 x-19 到 x 的 20 个点求平均”写成一个新函数。运行后不会立即出图；它只是定义均线。", "Text",ExpressionUUID->"1d2516ce-dfef-4fdc-a330-460f40877b8e"],

Cell["mean20[x_] := Mean[Table[f[x - k], {k, 0, 19}]]", "Input",ExpressionUUID->"de286bad-83cc-4ffa-9c03-e5a4da5c7bca"],

Cell["现在画蓝色价格曲线与红色 20 日均线。注意红线是否正好在 0 上。", "Text",ExpressionUUID->"0a8682a5-1e9a-4112-b3bf-6ed812b4d8a9"],

Cell["Plot[Evaluate[{f[x], mean20[x]}], {x, 0, 60},\n PlotRange -> {-1.2, 1.2},\n PlotStyle -> {Blue, {Red, Thick}},\n PlotLegends -> {\"price f(x)\", \"20-day mean\"},\n GridLines -> {Range[0, 60, 20], {0}}]", "Input",ExpressionUUID->"06cbdfe1-1bf8-4635-a1cd-9eea8e1cf3f1"],

Cell["交互问题：把滑块拖到 20。红线会是水平的；如果把它拖到 19 或 21，红线就会重新波动。这就是“窗口恰好包含一个周期”的可视化。", "Text",ExpressionUUID->"af1c09fb-c94c-47fb-bd0e-b04fbfa13b40"],

Cell["ma[x_, n_] := Mean[Table[f[x - k], {k, 0, n - 1}]];\nManipulate[\n Plot[Evaluate[{f[x], ma[x, n]}], {x, 0, 60},\n  PlotRange -> {-1.2, 1.2},\n  PlotStyle -> {Blue, {Red, Thick}},\n  PlotLegends -> {\"price f(x)\", \"n-day mean\"},\n  GridLines -> {Range[0, 60, 20], {0}}],\n {{n, 20, \"window length (days)\"}, 5, 40, 1, Appearance -> \"Labeled\"}\n]", "Input",ExpressionUUID->"bc4d0672-5867-434f-b59e-04872f0734e5"]
}, Open  ]]

,
Cell[CellGroupData[{

Cell["metapairs：统计套利 spread 的 trailing 均线", "Section",ExpressionUUID->"b666523c-6123-4dd7-a5d1-3dc7d6592d0c"],

Cell["这一节先从 quant_data.metapairs 读取 active pair，再按共同日线构造两条腿与 spread = Y - beta X。beta 是你指定并固定的数，默认 0.642；spread 的均线与 sigma 都只使用 t 日及此前的数据。面板的 fit endpoint-detrended global beta 按端点连线的残差平方最小来拟合固定 beta，并在图上画出浅灰端点趋势线。它是全样本研究拟合，必须冻结后在未来独立样本检验，不能把同一段历史内的结果当成当时已知。", "Text",ExpressionUUID->"85e96abf-bde2-4f91-8ccb-18243cab88ce"],

Cell["Get[FileNameJoin[{NotebookDirectory[], \"AACENXDailyMovingAverageLab.wl\"}]];\nAACENXDailyMovingAverageLab[]", "Input",ExpressionUUID->"cd42330a-3f8e-4817-8ae4-3bf0e453d07f"]
}, Open  ]]

,
Cell[CellGroupData[{

Cell["两条正弦腿：beta 为什么会局部有效？", "Section",ExpressionUUID->"e5e24446-d8e0-4264-a7d5-7308591150e5"],

Cell["B 只改变 spread 的基线，不改变波动大小；因此改为随时间变化的振幅。两腿现在是 f[t] = 1 + A (1 + slope t/240) Sin[...]。slope = 0 表示振幅恒定；slope = 1 表示第 240 天振幅为起始时的两倍。默认同频同相、AA 振幅 0.30、CENX 振幅 0.50，所以两条 slope 也相同时，beta = 0.30/0.50 = 0.6 会全程抵消。只把 CENX amplitude slope 调大，固定 beta = 0.6 就会从起初接近抵消、逐渐变为明显波动。spread 图的 y-axis centre 与 y-axis half-range 固定纵轴尺度。白线始终是 trailing spread mean。", "Text",ExpressionUUID->"6d410dd8-0bfb-4a7f-aeda-1c0f689a0d24"],

Cell["Get[FileNameJoin[{NotebookDirectory[], \"AACENXDailyMovingAverageLab.wl\"}]];\nAACENXSineSpreadLab[]", "Input",ExpressionUUID->"73d56029-596c-49f6-8627-e3671076ff03"]
}, Open  ]]
}, Open  ]]
},
