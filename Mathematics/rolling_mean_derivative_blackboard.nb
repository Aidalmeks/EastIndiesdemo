Cell[CellGroupData[{

Cell["\<\
Clear[p, t, ma]
ma[t_] := Sum[p[t - k], {k, 0, 19}]/20
FullSimplify[ma[t] - ma[t - 1]]\
\>", "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"367e5ae9-61de-4fbb-9068-268c99642eb5"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "20"], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"p", "[", 
      RowBox[{
       RowBox[{"-", "20"}], "+", "t"}], "]"}]}], "+", 
    RowBox[{"p", "[", "t", "]"}]}], ")"}]}]], "Output",
 CellChangeTimes->{3.9952478171945477`*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"33d8e35c-118d-4ff9-810e-423722b43647"]
}, Open  ]],

Cell["\:9884\:671f\:7ed3\:679c\:ff1a(p[t] - p[t - 20])/20", "Text",ExpressionUUID->"de77725b-a76c-4426-86b4-af486d0be241"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. \:5bf9\:5b9e\:9645\:6536\:76d8\:4ef7\:5217\:8868\:8ba1\:7b97", \
