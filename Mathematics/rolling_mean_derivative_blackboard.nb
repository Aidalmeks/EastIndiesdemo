Cell["prices \:5e94\:6309\:65f6\:95f4\:4ece\:65e9\:5230\:665a\:6392\:5217\
\:3002\:4e0b\:9762\:7684\:4e24\:79cd\:8ba1\:7b97\:5e94\:7ed9\:51fa\:540c\:4e00\
\:5217\:8868\:3002", "Text",ExpressionUUID->"baee7c8d-54f3-42e0-b691-\
8d98ea96497b"],

Cell["先运行这个演示价格列表，就不会出现 prices 未定义的报错。以后使用真实行情时，只需把这一格替换为你自己的收盘价列表。", "Text",ExpressionUUID->"e2861ea9-c1d7-425d-bebd-af71769f1498"],

Cell["prices = Table[100 + Sin[2 Pi t/20], {t, 0, 79}];", "Input",ExpressionUUID->"980e21f0-6ac3-47c5-93b7-c65fdad3bcd4"],

Cell[CellGroupData[{

Cell["\<\
rolling20 = MovingAverage[prices, 20];
derivativeDaily = Differences[rolling20];

derivativeDirect = Table[(prices[[i]] - prices[[i - 20]])/20,
  {i, 21, Length[prices]}];

derivativeDaily == derivativeDirect\
\>", "Input",
 CellLabel->"In[29]:=",ExpressionUUID->"e50ed20f-8f87-428a-bdfa-c2f93416f145"],

