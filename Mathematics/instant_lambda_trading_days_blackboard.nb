(* Content-type: application/vnd.wolfram.mathematica *)
(*** Wolfram Notebook File ***)
(* CreatedBy='Wolfram 15.0' *)
Notebook[{
Cell[CellGroupData[{
Cell["Fixed-beta spread：逐交易日 lambda 黑板", "Title"],
Cell["SBLK / BHP · 共同交易日日线 · 可逐点查看价格、spread、rolling mu、sigma、raw lambda 与有效 lambda。", "Subtitle"],
Cell["使用方式：从上到下执行前两段 Input。第三段图的横轴是连续 trading-bar，不为周末或节假日留空；拖动滑块或将鼠标停在蓝色 spread 点上，可以检查每一根 bar 的全部参数。", "Text"],
Cell[CellGroupData[{
Cell["1. 参数与共同交易日日线", "Section"],
Cell["SQL 使用 inner join，因此只留下 SBLK 和 BHP 同时有价格的交易日。开始日期只决定样本；不做首日归一化。", "Text"],
Cell["tickerY = \"SBLK\"; tickerX = \"BHP\";\nstartDate = \"2026-01-02\"; rollingWindow = 20;\n\nsql = StringJoin[\n  \"SELECT a.trade_date, a.price, b.price FROM us_market_days a JOIN us_market_days b \",\n  \"ON b.ticker='\", tickerX, \"' AND b.trade_date=a.trade_date \",\n  \"WHERE a.ticker='\", tickerY, \"' AND a.trade_date >= '\", startDate, \"' ORDER BY a.trade_date\"\n];\nrawRows = ImportString[RunProcess[{\"/usr/bin/mysql\", \"-uquant\", \"-p1q2w3e\", \"--batch\", \"--skip-column-names\", \"quant_data\", \"-e\", sql}, \"StandardOutput\"], \"TSV\"];\nIf[Length[rawRows] <= rollingWindow, Throw[\"Not enough common trading-day rows.\"]];\ndates = DateObject /@ rawRows[[All, 1]];\ny = ToExpression /@ rawRows[[All, 2]];\nx = ToExpression /@ rawRows[[All, 3]];\nbars = Range[Length[dates]];\nPrint[\"Common trading-day bars: \", Length[bars], \"  (\", DateString[First[dates], \"ISODate\"], \" to \", DateString[Last[dates], \"ISODate\"], \")\"]", "Input"]
}, Open]],
Cell[CellGroupData[{
Cell["2. 固定最小方差 beta、rolling mu 与 lambda", "Section"],
Cell["beta 与 Python notebook 一致：对原始价格做端点去趋势后，最小化 D(y)-beta D(x) 的平方和。raw lambda 在上一根偏离接近零时不稳定；图中保留每个可计算 bar，先将 previous z-score 的绝对值下限截断为 0.25。若初算 lambda<-1 且原始 previous z-score 接近零，则反转该 z-score 的符号后重算，用于上色。raw 值仍完整保留。", "Text"],
Cell["endpointDetrend[v_] := v - Subdivide[First[v], Last[v], Length[v] - 1];\ndy = endpointDetrend[y]; dx = endpointDetrend[x];\nbetaMinVariance = N[(dx.dy)/(dx.dx)];\nspread = y - betaMinVariance x;\n\nrollMean = Join[ConstantArray[Missing[\"window\"], rollingWindow - 1], MovingAverage[spread, rollingWindow]];\npopSigma[v_] := Sqrt[Mean[(v - Mean[v])^2]];\nrollSigma = Table[If[i < rollingWindow, Missing[\"window\"], popSigma[Take[spread, {i - rollingWindow + 1, i}]]], {i, Length[spread]}];\nupper2 = rollMean + 2 rollSigma; lower2 = rollMean - 2 rollSigma;\ndeviation = spread - rollMean;\nzScore = MapThread[If[NumericQ[#1] && NumericQ[#2] && #2 != 0, #1/#2, Missing[\"undefined\"]] &, {deviation, rollSigma}];\n\nspreadChange = Prepend[Differences[spread], Missing[\"first\"]];\nlagDeviation = Prepend[Most[deviation], Missing[\"first\"]];\nlagSigma = Prepend[Most[rollSigma], Missing[\"first\"]];\nlagZ = MapThread[If[NumericQ[#1] && NumericQ[#2] && #2 != 0, #1/#2, Missing[\"undefined\"]] &, {lagDeviation, lagSigma}];\nlambdaRaw = MapThread[If[NumericQ[#1] && NumericQ[#2] && #2 != 0, #1/#2, Missing[\"undefined\"]] &, {spreadChange, lagDeviation}];\nminAbsLagZ = .25;\nlagZForLambda = Map[If[NumericQ[#] && # != 0, Sign[#] Max[Abs[#], minAbsLagZ], Missing[\"undefined\"]] &, lagZ];\nlagDeviationForLambda = lagZForLambda lagSigma;\nlambdaInitial = MapThread[If[NumericQ[#1] && NumericQ[#2] && #2 != 0, #1/#2, Missing[\"undefined\"]] &, {spreadChange, lagDeviationForLambda}];\ncrossingReestimate = MapThread[TrueQ[NumericQ[#1] && #1 < -1 && NumericQ[#2] && Abs[#2] < minAbsLagZ] &, {lambdaInitial, lagZ}];\nlagZForLambda = MapThread[If[#2, -#1, #1] &, {lagZForLambda, crossingReestimate}];\nlagDeviationForLambda = lagZForLambda lagSigma;\nlambdaInstant = MapThread[If[NumericQ[#1] && NumericQ[#2] && #2 != 0, #1/#2, Missing[\"undefined\"]] &, {spreadChange, lagDeviationForLambda}];\nfiniteLambda = Select[lambdaInstant, NumericQ];\ncolorLimit = Quantile[Abs[finiteLambda], .98];\n\npointRows = Table[<|\"bar\" -> bars[[i]], \"date\" -> DateString[dates[[i]], \"ISODate\"], \"deviation\" -> deviation[[i]], \"zScore\" -> zScore[[i]], \"lagZ\" -> lagZ[[i]], \"lambdaRaw\" -> lambdaRaw[[i]], \"lambda\" -> lambdaInstant[[i]]|>, {i, Length[bars]}];\nPrint[\"fixed beta = \", NumberForm[betaMinVariance, {8, 6}], \"; usable lambda bars = \", Length[finiteLambda]];", "Input"]
}, Open]],
Cell[CellGroupData[{
Cell["3. 连续交易日图：lambda 填充在 mu ± 2 sigma 内", "Section"],
Cell["蓝色代表 lambda<0（局部回归），红色代表 lambda>0（局部发散），负 lambda 为蓝、正 lambda 为红；颜色强度连续随绝对值变化。previous z-score 接近零时先按同号截断至 +/-0.25；若初算 lambda<-1，则反转该 previous z-score 的符号后重算。", "Text"],
Cell["lambdaColor[v_] := If[! NumericQ[v], GrayLevel[.88], Blend[{Blue, White, Red}, Rescale[Clip[v, {-colorLimit, colorLimit}], {-colorLimit, colorLimit}]]];\nformat[v_] := If[NumericQ[v], NumberForm[v, {10, 5}], \"—\"];\npointDetail[i_] := Grid[{{\"trading bar\", pointRows[[i, \"bar\"]]}, {\"date\", pointRows[[i, \"date\"]]}, {\"spread - rolling mu\", format[pointRows[[i, \"deviation\"]]]}, {\"z-score\", format[pointRows[[i, \"zScore\"]]]}, {\"previous-bar z-score (lambda denominator)\", format[pointRows[[i, \"lagZ\"]]]}, {\"lambda raw\", format[pointRows[[i, \"lambdaRaw\"]]]}, {\"lambda used for color\", format[pointRows[[i, \"lambda\"]]]}}, Frame -> All, Alignment -> Left, Background -> {None, {Lighter[Gray, .94], None}}];\n\nModule[{band, curves, points, labels, tickBars},\n  band = Flatten@Table[If[And @@ (NumericQ /@ {lower2[[i - 1]], lower2[[i]], upper2[[i - 1]], upper2[[i]]}), {Opacity[.62], lambdaColor[lambdaInstant[[i]]], Polygon[{{bars[[i - 1]], lower2[[i - 1]]}, {bars[[i]], lower2[[i]]}, {bars[[i]], upper2[[i]]}, {bars[[i - 1]], upper2[[i - 1]]}}]}, Nothing], {i, 2, Length[bars]}];\n  curves = ListLinePlot[{Transpose[{bars, upper2}], Transpose[{bars, lower2}], Transpose[{bars, rollMean}], Transpose[{bars, spread}]}, PlotStyle -> {Directive[GrayLevel[.25], Thin], Directive[GrayLevel[.25], Thin], Directive[Black, Dashed, Thick], Directive[Blue, Thick]}, PlotRange -> All, Frame -> True, FrameLabel -> {\"consecutive trading-day bar\", \"price-unit spread\"}, ImageSize -> Full, AspectRatio -> .45, PlotLegends -> {\"mu + 2 sigma\", \"mu - 2 sigma\", \"rolling mu\", \"fixed-beta spread\"}];\n  points = Graphics@Table[Tooltip[{Directive[PointSize[.018], Opacity[.01]], Point[{bars[[i]], spread[[i]]}]}, pointDetail[i]], {i, Length[bars]}];\n  tickBars = Round /@ Subdivide[1, Length[bars], 9];\n  labels = Thread[{bars[[tickBars]], (DateString[#, \"ISODate\"] & /@ dates[[tickBars]])}];\n  Show[Graphics[band], curves, points, FrameTicks -> {{Automatic, Automatic}, {labels, None}}, ImageSize -> {1600, 850}, AspectRatio -> .5]\n]", "Input"]
}, Open]]
}, Open]]
},
WindowTitle -> "Fixed-beta spread：逐交易日 lambda 黑板",
StyleDefinitions -> "Default.nb"
]
